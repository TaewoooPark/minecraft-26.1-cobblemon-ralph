+    // LABEL-FIX helper (iter#157): true if any opaque block is between camera and entity center.
+    // Uses Level.clip with BLOCK shape + NONE fluid; returns HitResult.Type.BLOCK if blocked.
+    private fun isOccludedByOpaqueBlock(entity: PokemonEntity): Boolean {
+        val mc = Minecraft.getInstance()
+        val camera = mc.gameRenderer.mainCamera
+        val level = entity.level()
+        // Camera world position
+        val from = Vec3(camera.position.x, camera.position.y, camera.position.z)
+        // Aim at entity bounding box center (slightly above feet — label is at top)
+        val bb = entity.boundingBox
+        val to = Vec3(
+            (bb.minX + bb.maxX) * 0.5,
+            bb.minY + bb.ysize * 0.75,
+            (bb.minZ + bb.maxZ) * 0.5
+        )
+        // Skip raycast if camera is inside entity bounding box (would always self-block)
+        if (bb.contains(from)) return false
+        val ctx = ClipContext(
+            from, to,
+            ClipContext.Block.COLLIDER,   // only solid blocks; matches vanilla nametag depth-test intent
+            ClipContext.Fluid.NONE,
+            entity
+        )
+        return level.clip(ctx).type == HitResult.Type.BLOCK
+    }
+
